# CID SHS Portal - Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit the .env file with real credentials

# ==================== SERVER ====================

# Server port (default 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shs

# JWT Secret (generate a random 32+ character string for production)
JWT_SECRET=your-super-secret-key-change-this-in-production

# Frontend Origins (comma-separated if multiple)
# For development, this typically includes the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost,http://127.0.0.1

# ==================== CLIENT ====================

# Backend API URL (optional - defaults to same-origin /api in dev, uses Vite proxy)
# Uncomment to override:
# VITE_API_URL=http://localhost:5000

# API Origin for production builds
# VITE_API_ORIGIN=https://your-api-domain.com

# Enable local HTTPS for testing (set to 'true' to enable)
# VITE_LOCAL_HTTPS=false

# ==================== OPTIONAL: Email/SMTP ====================

# Gmail or SMTP server settings (for password recovery emails)
# Uncomment and fill if you want email functionality

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=your-email@gmail.com

# Or use specific Gmail settings:
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-specific-password
