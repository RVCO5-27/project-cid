# Copy to .env and fill in values. Never commit .env.

PORT=5000
NODE_ENV=development

# MySQL (must match database created from database/shs.sql or your schema)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=shs
# Optional: single connection string (common on Render / managed MySQL)
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME
# DB_PASSWORD=   # alias for DB_PASS if your host only provides DB_PASSWORD
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false   # only if your provider requires relaxed SSL
# DB_SSL_CA=cert/isrgrootx1.pem      # optional PEM for TiDB/RDS verify (path relative to backend/)
# TiDB Cloud: TLS is auto-enabled for tidbcloud.com URLs; set DB_SSL=false only for local non-TLS MySQL.


# JWT — in production use a long random string (32+ characters)
JWT_SECRET=change-me-in-development-only

# CORS — comma-separate multiple browser origins (e.g. Vite + production)
# FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
#
# Single URL for links in emails (recovery). If unset, first FRONTEND_ORIGIN entry is used.
# FRONTEND_APP_URL=https://your-app.vercel.app

# Recovery emails (optional — without SMTP, link is logged to server console in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@deped.gov.ph

# Gmail alternative (recommended for personal Gmail testing)
# GMAIL_USER=your.account@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
